# Scout environment variables
# Copy to .env.local and fill in.

# ---- MiniMax (primary reasoning layer) ----
# https://www.minimax.io/platform  — Group/API key required.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# Default chat model. Swap tiers here for cost/quality tradeoffs.
MINIMAX_MODEL=MiniMax-Text-01
# Cheaper routing/rewrite model. Falls back to MINIMAX_MODEL if unset.
MINIMAX_ROUTER_MODEL=
# Base URL (override for regional endpoints / proxies).
MINIMAX_BASE_URL=https://api.minimax.io/v1

# ---- Web search provider ----
# Scout supports tavily | exa | serpapi | mock (default mock for local dev).
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=

# ---- Embeddings (for uploaded-doc retrieval) ----
# Options: minimax | openai | mock (default mock -> lexical-only retrieval).
EMBEDDINGS_PROVIDER=mock
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Composio (connected apps: Drive, Gmail, Notion, Slack, GitHub, Calendar) ----
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev

# ---- Storage ----
# Scout uses a local JSON store at .data/ for dev. Swap to Postgres in prod.
SCOUT_DATA_DIR=.data
SCOUT_UPLOAD_DIR=uploads

# ---- Quotas (cost controls) ----
SCOUT_FREE_DAILY_QUERIES=15
SCOUT_PLUS_MONTHLY_QUERIES=1500
SCOUT_PRO_SEARCH_MONTHLY=50
